{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1",
    "MSBUILDDISABLENODEREUSE": "1",
    "AMA_BUILD_WAIT_MAX_SECS": "540"
  },
  "permissions": {
    "allow": [
      "Edit",
      "Bash",
      "PowerShell",
      "Read",
      "Skill",
      "Grep",
      "Glob",
      "Write",
      "Agent",
      "Agent(WriteFile)",
      "Agent(ReadFile)",
      "Agent(DeleteFile)",
      "Agent(MoveFile)",
      "Agent(Explore)",
      "ExitPlanMode",
      "LSP",
      "Monitor",
      "NotebookEdit",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "WebSearch(*)",
      "Artifact",
      "Artifact(*)",
      "KillShell",
      "Write(*)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(*)",
      "Bash(git *)",
      "Bash(dotnet *)",
      "Bash(bash \"$HOME/.claude/*)",
      "Bash(bash ~/.claude/*)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(rmdir *)",
      "PowerShell(del *)",
      "PowerShell(rd *)",
      "PowerShell(ri *)",
      "PowerShell(erase *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "mcp__claude_ai_Google_Calendar__list_calendars",
      "mcp__claude_ai_Google_Calendar__search_events",
      "mcp__claude_ai_Google_Calendar__list_events",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Slack__slack_send_message",
      "mcp__claude_ai_Slack__slack_send_message_draft",
      "mcp__claude_ai_Slack__slack_search_users",
      "mcp__claude_ai_Slack__slack_search_channels",
      "mcp__claude_ai_Slack__slack_search_public_and_private",
      "mcp__claude_ai_Slack__slack_read_thread",
      "mcp__claude_ai_Slack__slack_read_channel",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Zoom_for_Claude__hub_get_file_content",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude-in-chrome"
    ],
    "deny": [
      "mcp__claude_ai_Atlassian__*",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * -o /etc/*)",
      "Bash(curl * -o /usr/*)",
      "Bash(sudo *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(chown *)",
      "Bash(kill *)",
      "Bash(xargs *)",
      "Bash(fdisk *)",
      "Bash(erase *)",
      "Bash(iwr *)",
      "Bash(irm *)",
      "Bash(iex *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "PowerShell(curl * | iex*)",
      "PowerShell(sudo *)",
      "PowerShell(eval *)",
      "PowerShell(kill *)",
      "PowerShell(chown *)",
      "PowerShell(Stop-Process *)",
      "PowerShell(iwr *)",
      "PowerShell(irm *)",
      "PowerShell(iex *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: YourCompany. Primary use of Claude Code: software development and infrastructure automation on the AMA_APP (PROJ) fleet.",
      "Source control: Bitbucket Cloud org `yourorg` -- all repos under it, primarily the `product-service-*` repos.",
      "Cloud provider(s): AWS, account 000000000000, region us-east-1 (ECS, Lambda, ElastiCache, DocumentDB, Redshift).",
      "Internal package registry: AWS CodeArtifact domain `yourorg`, repository `<repository>` -- the `YourCompany.Product.*` NuGet libraries install from there.",
      "Key internal services: Octopus Deploy at https://yourorg.octopus.app (Spaces-1); Graylog at http://your-graylog-host:9000; Jira/Confluence Cloud at yourorg.atlassian.net; the <one entry per line; this element only declares the type> vendor site at embs.com.",
      "Trusted internal domains: example-app.com and its qa./staging./dev./admin-qa. subdomains -- the AMA app's own environments.",
      "Sensitive remote targets: the Octopus Production environment (<production>), production ECS clusters, and the production DocumentDB / Postgres / Redshift clusters.",
      "Repository visibility: private -- every repo in this fleet is a private Bitbucket Cloud repo under the `yourorg` org. None are public.",
      "Org-specific CLIs: this harness's own scripts under `~/.claude/scripts` and `~/.claude/hooks` (octopus-config-sync.sh, jira-*.sh, rs-query.sh, embs-notices-*.sh, verify-*.sh), plus `aws`, `gh`, `dotnet`, and direct curl calls to the Octopus / Graylog / Atlassian / Bitbucket REST APIs.",
      "Secrets management: the shared harness config lives in the Octopus 'Claude Harness' library variable set; per-person credentials live only in shell env vars (ATLASSIAN_API_TOKEN, BITBUCKET_API_KEY, GRAYLOG_PAT, OCTOPUS_API_KEY, MONGO_SSH_KEY_PASSPHRASE). Secrets are never committed to a repo.",
      "CI/CD deploy targets: Bitbucket Pipelines builds and publishes NuGet packages to AWS CodeArtifact; Octopus Deploy (Spaces-1, projects `product-service-*` and `other-project-*`) deploys to Development (<development>), QA (<qa>), Staging (<staging>) and Production (<production>).",
      "Trusted cloud buckets: s3://example-app.com, s3://www.example-app.com, s3://qa.yourapp.example.com, s3://staging.yourapp.example.com and s3://ama-qa.yourapp.example.com (the S3-hosted exporterplus/admin frontends), plus s3://hs-aggregation-api-packages and s3://hs-pipelines (build artifacts).",
      "Personal config repos: ~/.claude is a git repo whose remote (github.com/rsryanstephen/Claude-Config) is a single-owner private config mirror belonging to this one developer; the harness content under it also lives in the private company Bitbucket repo yourorg/ama-claude-harness, which is inside the YourCompany trust boundary (company org admins can read it, so not literally one-person, but not a third party either). Pushing to either is routine self-backup within the trust boundary, not sharing to an external third party."
    ],
    "allow": [
      "$defaults",
      "Harness self-maintenance (single-developer machine): editing, committing, and pushing the harness config owned by this one developer is trusted personal-config maintenance, not shared-team-infrastructure modification. For THIS rule the enumerated harness paths are NOT treated as sensitive-tier dot-folder content: ~/.claude/skills/, ~/.claude/hooks/, ~/.claude/scripts/, ~/.claude/settings.json, ~/.claude/AGENTS.md, ~/.claude/CLAUDE.md, ~/.claude/memory/ (symlinked from the ama-claude-harness repo). Blesses ONLY those paths, and ONLY pushes to the Claude-Config / ama-claude-harness remotes already configured at session start; any OTHER ~/.claude path in the same commit falls back to defaults on its own -- it neither taints the blessed files nor is cleared by them. It does NOT cover, and defaults apply in full to: (a) edits that add or widen a permission/allow rule, disable or weaken any hook, sandbox, or approval gate, or write pre-authorization/consent content -- Self-Modification / Instruction Poisoning, regardless of this rule; for settings.json specifically, only an edit whose full added and removed content is visible in the tool call is eligible, otherwise defaults apply; (b) session transcripts under ~/.claude/projects/, any .credentials-type file, and any secret or token -- these keep sensitive-tier status and Credential Leakage / Sensitive-Source Provenance / Session Transcript Tampering still bite; (c) repointing a remote (git remote add / set-url) and then pushing.",
      "Release/hotfix branch cleanup (user decision 2026-09-18): after a release or hotfix branch has been MERGED to master and develop and its production deploy verified, deleting that branch is routine bookkeeping, not destructive work -- the commits live on master/develop. Covers ONLY refs matching release/* or hotfix/* in the yourorg Bitbucket repos: `git branch -D <ref>`, `git push origin --delete <ref>` (or the `:<ref>` refspec form), `git worktree remove --force` of a worktree checked out on such a ref, issued inline OR from a script file written in the same session, looping over several repos. It does NOT cover master, develop, or any other branch name, force-pushes, history rewrites, or deleting a release/hotfix branch that is not yet merged -- defaults apply in full there."
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/statusline.sh\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/sandbox-allow.sh\"",
            "shell": "bash",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/running-script-edit-gate.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking the target script is not mid-execution"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/symlink-write-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking for a direct write through a harness symlink"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/native-memory-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking for a write into native (non-durable) auto-memory"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/skill-bloat-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking skill edit for incident-narrative bloat"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/skill-model-tiering-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking skill model tiering"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/standup-empty-section-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking standup notes for an unearned empty section"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/claude-dir-clutter-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking for a new top-level ~/.claude entry"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/transcript-scan-bound-nudge.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a hook edit bounds its transcript read"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/jit-pointer-nudge.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking whether an on-demand reference doc pointer is due"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/file-claim-record.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Recording this session's claim on the edited file"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/chrome-verify-nudge.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking whether --chrome is worth suggesting for this UI verify"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/subagent-model-tiering-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking subagent model tiering"
          }
        ]
      },
      {
        "matcher": "mcp__.*__updateConfluencePage",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/confluence-media-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking an html write won't drop a nested image"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create_draft|update_draft|reply|forward)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/gmail-draft-sig-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking the draft's signature is real and current"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create_draft|update_draft|reply|forward|send_message)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/client-mail-cc-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking an ClientCorp mail copies ContactOne in"
          }
        ]
      },
      {
        "matcher": "mcp__.*__addCommentToJiraIssue|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/regression-comment-brevity-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a regression comment stays brief"
          }
        ]
      },
      {
        "matcher": "mcp__.*__transitionJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/ready-to-test-readiness-gate.sh\"",
            "shell": "bash",
            "timeout": 25,
            "statusMessage": "Checking a Ready-to-Test ticket carries description, testing steps and regression notes"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create_draft|update_draft|reply|forward|send_message|slack_send_message|slack_send_message_draft|slack_schedule_message)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/audience-policy-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Resolving how much detail this audience wants"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/hotfix-number-comms-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a hotfix number isn't named"
          }
        ]
      },
      {
        "matcher": "mcp__.*__slack_send_message|mcp__.*__slack_send_message_draft|mcp__.*__slack_schedule_message",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/slack-brevity-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking the Slack message is short"
          }
        ]
      },
      {
        "matcher": "mcp__.*__slack_send_message_draft",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/slack-draft-existing-reminder.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Noting that Slack may silently drop a draft"
          }
        ]
      },
      {
        "matcher": "mcp__.*__createJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/jira-ticket-fields-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking new Jira ticket has an assignee"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/harness-ticket-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking ticket isn't a harness sub-ticket"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/jira-ticket-description-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking new Jira ticket has a filled-in description"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(createJiraIssue|editJiraIssue)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/jira-fixversion-confirm-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking release/hotfix Fix Version is confirmed created"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/dispatch.sh\" \"$HOME/.claude/hooks/dispatch-pre-bash.manifest\"",
            "shell": "bash",
            "timeout": 660,
            "statusMessage": "Running Bash gate block (dispatched)"
          }
        ]
      },
      {
        "matcher": "advisor",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/advisor-standard-process-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking advisor() is not mid-procedure"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/backlog-pick-no-ask-gate.sh\"",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking this is not a which-ticket question mid backlog pick"
          }
        ]
      },
      {
        "matcher": "CronCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/cron-oneshot-durable-gate.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Redirecting one-shot reminders to the durable queue"
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/dotfile-secret-print-gate.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for a credential-file print"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/docker-wedge-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking for a hung Docker engine"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/vpn-dns-outage-logger.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking a failed command for a DNS resolver error"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/harness-edit-hash.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Recording harness edit hash for cross-session guard"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/readme-currency-gate.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking AGENTS.md currency for harness edit"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/check-gates-currency-gate.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking check-gates currency for harness edit"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/human-readme-edit-gate.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking README.md edit is human-visible"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/octopus-config-push-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/ama-skill-symlink-nudge.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a new ama-* skill has its browsing symlink"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/alwaysloaded-size-gate.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking always-loaded surfaces stay small"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/dispatch-needle-currency-gate.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking dispatched-gate needle currency"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/config-key-parity-reminder.sh\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking harness-config key parity"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/it-ticket-paste-format-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking an IT ticket draft pastes cleanly into the IT portal"
          }
        ]
      },
      {
        "matcher": "mcp__.*__createJiraIssue",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/backlog-page-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking new ticket is on the AMA Backlog"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|update)_draft",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/gmail-reply-thread-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a reply draft landed on the intended thread"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(addCommentToJiraIssue|transitionJiraIssue)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/ready-to-test-regression-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a Ready-to-Test ticket owes its regression comment"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__tabs_close_mcp",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/chrome-verify-compact-nudge.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking whether a /compact nudge is due after closing a verify tab"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/dev-server-tab-close-teardown.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Killing the dev server this session started, now that its verify tab closed"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/session-name-sync.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Syncing session name mid-turn"
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/chrome-activity-track.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Recording claude-in-chrome activity for the idle /compact nudge"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/dispatch.sh\" \"$HOME/.claude/hooks/dispatch-post-bash.manifest\"",
            "shell": "bash",
            "timeout": 120,
            "statusMessage": "Running Bash post-hook block (dispatched)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/log-session-start.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Logging session resume command"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/chrome-compact-rearm.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Re-arming the post-verify /compact nudge after a compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/on-prompt.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 180,
            "statusMessage": "Logging prompt + naming session"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/on-stop.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Mirroring reply text to session log"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/self-checkable-ask-reminder.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking the reply didn't hand the user a self-checkable question"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/learned-lesson-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a learned lesson was recorded in the harness"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/deferred-window-reminder-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking deferred after-hours work has a reminder"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/limit-resume-stop-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking the usage-limit resume audit was answered"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/notify-sound.sh\" stop 2>/dev/null || true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Playing turn-finished sound"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/harness-config-unsynced-stop-gate.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking harness-config.json was pushed to Octopus"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/octopus-approval-watch-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a handed-off deploy has a watcher"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/terraform-plan-approval-review-check.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 20,
            "statusMessage": "Checking a recommended plan approval was reviewed"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/notify-sound.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Playing attention-needed sound"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/hook-run.sh\" \"$HOME/.claude/hooks/on-session-end.sh\" 2>/dev/null || true",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Logging resume command on exit"
          }
        ]
      }
    ]
  }
}
